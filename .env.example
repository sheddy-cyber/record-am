# ============================================================
# RECORD AM - Environment Variables
# ============================================================
# 1. Copy this file and rename it to .env
# 2. Fill in your Supabase credentials from your project dashboard
#    Go to: https://supabase.com → Your Project → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Voice commands (optional).
# Recommended: leave this unset and deploy supabase/functions/voice-command with
# GROQ_API_KEY stored as a server secret. A key set here is bundled into the app.
# EXPO_PUBLIC_GROQ_API_KEY=
