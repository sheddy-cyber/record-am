# ============================================================
# RECORD AM - Environment Variables
# ============================================================
# 1. Copy this file and rename it to .env
# 2. Fill in your Supabase credentials from your project dashboard
#    Go to: https://supabase.com → Your Project → Settings → API

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Voice commands need no key in the app. They run through the
# supabase/functions/voice-command server function, which reads GROQ_API_KEY
# from the project's secrets:
#   supabase secrets set GROQ_API_KEY=gsk_...
#   supabase functions deploy voice-command
# Never put a provider key in an EXPO_PUBLIC_ variable: those are bundled into the app.
