{
  "expo": {
    "name": "Record Am",
    "slug": "record-am",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "jsEngine": "hermes",
    "assetBundlePatterns": [
      "assets/fonts/*.otf",
      "assets/*.png"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.recordam.app",
      "jsEngine": "hermes"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#efefd0"
      },
      "package": "com.recordam.app",
      "versionCode": 1,
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true,
      "jsEngine": "hermes"
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo.png",
          "color": "#E2C75B",
          "defaultChannel": "record-am"
        }
      ]
    ],
    "scheme": "recordam",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
